{
  "name": "Day 2 - RAG Ingestion",
  "nodes": [
    {
      "parameters": {
        "pollTimes": { "item": [{ "mode": "everyMinute" }] },
        "triggerOn": "specificFolder",
        "folderToWatch": { "__rl": true, "mode": "id", "value": "<YOUR_GOOGLE_DRIVE_KB_FOLDER_ID>" },
        "event": "={{ \"fileCreated\" }}",
        "options": {}
      },
      "id": "964f2613-b2e0-43dc-8b5b-f9c816d3a42b",
      "name": "Watch KB Folder",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [240, 304]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": { "__rl": true, "mode": "id", "value": "={{ $json.id }}" },
        "options": { "binaryPropertyName": "data" }
      },
      "id": "ccd765e7-abb7-4323-8bfc-6ed7fb3e6342",
      "name": "Download File",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [464, 304]
    },
    {
      "parameters": { "operation": "text", "destinationKey": "content", "options": {} },
      "id": "116b8416-1518-4e89-9989-f44e60eab181",
      "name": "Extract Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [688, 304]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "delete from documents where metadata->>'doc_id' = $1;",
        "options": { "queryReplacement": "={{ [ $(\"Watch KB Folder\").item.json.id ] }}" }
      },
      "id": "e0acc991-7008-42fa-baa9-264e949b7660",
      "name": "Delete Stale Chunks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [912, 304],
      "notes": "Re-ingestion safety: removes previous chunks for this doc_id before inserting the new version, so edited/renamed docs don't leave orphaned stale chunks in the vector store."
    },
    {
      "parameters": {
        "mode": "insert",
        "tableName": "documents",
        "options": {
          "columnNames": {
            "values": {
              "idColumnName": "id",
              "vectorColumnName": "embedding",
              "contentColumnName": "content",
              "metadataColumnName": "metadata"
            }
          }
        }
      },
      "id": "85b6eb48-d3e4-4e82-94f1-009cf4bfae1b",
      "name": "Insert into Supabase pgvector",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePGVector",
      "typeVersion": 1.3,
      "position": [1168, 304],
      "credentials": { "postgres": { "name": "Postgres account" } }
    },
    {
      "parameters": { "model": "text-embedding-3-small", "options": {} },
      "id": "a3981ba6-c67f-449a-ba56-cb9669c33d52",
      "name": "Embeddings OpenAI",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [1136, 528],
      "credentials": { "openAiApi": { "name": "OpenAi account" } }
    },
    {
      "parameters": {
        "jsonMode": "expressionData",
        "jsonData": "={{ $(\"Extract Text\").item.json.content }}",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              { "name": "doc_id", "value": "={{ $(\"Watch KB Folder\").item.json.id }}" },
              { "name": "title", "value": "={{ $(\"Watch KB Folder\").item.json.name.replace(/\\.[^/.]+$/, \"\").replace(/^[0-9]+_/, \"\").replace(/_/g, \" \") }}" },
              { "name": "source_url", "value": "={{ \"https://drive.google.com/file/d/\" + $(\"Watch KB Folder\").item.json.id + \"/view\" }}" },
              { "name": "category", "value": "={{ $(\"Watch KB Folder\").item.json.name.toLowerCase().includes(\"shipping\") ? \"shipping\" : $(\"Watch KB Folder\").item.json.name.toLowerCase().includes(\"return\") ? \"returns\" : $(\"Watch KB Folder\").item.json.name.toLowerCase().includes(\"care\") ? \"care\" : $(\"Watch KB Folder\").item.json.name.toLowerCase().includes(\"sizing\") ? \"sizing\" : $(\"Watch KB Folder\").item.json.name.toLowerCase().includes(\"faq\") ? \"faq\" : $(\"Watch KB Folder\").item.json.name.toLowerCase().includes(\"catalog\") ? \"catalog\" : ($(\"Watch KB Folder\").item.json.name.toLowerCase().includes(\"packaging\") || $(\"Watch KB Folder\").item.json.name.toLowerCase().includes(\"sustain\")) ? \"sustainability\" : $(\"Watch KB Folder\").item.json.name.toLowerCase().includes(\"tone\") ? \"tone\" : \"general\" }}" }
            ]
          }
        }
      },
      "id": "8b362dbe-6e59-4c35-b97c-0a86e18ff096",
      "name": "Default Data Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [1264, 528]
    },
    {
      "parameters": { "chunkSize": 2000, "chunkOverlap": 300, "options": { "splitCode": "markdown" } },
      "id": "27c5691f-c389-410f-9efc-f45430d9ec6b",
      "name": "Heading-Aware Splitter",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [1344, 736],
      "notes": "2000 chars / 15% overlap, split on markdown headings first so chunk boundaries respect semantic sections rather than cutting mid-policy."
    }
  ],
  "connections": {
    "Watch KB Folder": { "main": [[{ "node": "Download File", "type": "main", "index": 0 }]] },
    "Download File": { "main": [[{ "node": "Extract Text", "type": "main", "index": 0 }]] },
    "Extract Text": { "main": [[{ "node": "Delete Stale Chunks", "type": "main", "index": 0 }]] },
    "Delete Stale Chunks": { "main": [[{ "node": "Insert into Supabase pgvector", "type": "main", "index": 0 }]] },
    "Embeddings OpenAI": { "ai_embedding": [[{ "node": "Insert into Supabase pgvector", "type": "ai_embedding", "index": 0 }]] },
    "Heading-Aware Splitter": { "ai_textSplitter": [[{ "node": "Default Data Loader", "type": "ai_textSplitter", "index": 0 }]] },
    "Default Data Loader": { "ai_document": [[{ "node": "Insert into Supabase pgvector", "type": "ai_document", "index": 0 }]] }
  }
}
